# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
NODE_ENV=development

# ================================
# DATABASE
# ================================
# Local MongoDB
MONGO_URI=mongodb://localhost:27017/portfolio

# Production MongoDB (MongoDB Atlas)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ================================
# SECURITY - JWT & SESSION
# ================================
# CRITICAL: Generate strong secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG
SESSION_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_STRING_64_CHARS

# ================================
# FRONTEND URL
# ================================
# Local development
FRONTEND_URL=http://localhost:5173

# Production (Vercel)
# FRONTEND_URL=https://your-portfolio.vercel.app

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
# Required for: email verification, password reset, MFA notifications

# Gmail Example
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=noreply@portfolio.com
# SMTP_FROM_NAME=Portfolio Admin

# SendGrid Example
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@portfolio.com
# SMTP_FROM_NAME=Portfolio Admin

# ================================
# SECURITY SETTINGS (Optional)
# ================================
# Account lockout after failed attempts
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in milliseconds (default: 30 minutes)
LOGIN_LOCK_TIME=1800000

# JWT token expiry (default: 7d)
JWT_EXPIRY=7d

# ================================
# MONITORING & LOGGING (Optional)
# ================================
# External logging service URL
# LOGGING_SERVICE=https://your-logging-service.com

# Enable debug logging
# DEBUG=true

# ================================
# PRODUCTION CHECKLIST
# ================================
# Before deploying to production:
# 1. Set NODE_ENV=production
# 2. Generate strong JWT_SECRET (64+ characters)
# 3. Generate strong SESSION_SECRET (64+ characters)
# 4. Configure SMTP settings for emails
# 5. Set production MONGO_URI
# 6. Set production FRONTEND_URL
# 7. Enable MFA for all admin accounts
# 8. Run: npm audit fix
# 9. Run: npm run security-audit

